new file mode 100644
index 0000000000000000000000000000000000000000..dbb6ec7e80dc824de440f4aa9c4be29b7beb7b5c
--- /dev/null
+++ b/source/core/net/wireguard_endpoint.cpp
@@ -0,0 +1,358 @@
+#include "core/net/wireguard_endpoint.hpp"
+
+#include <algorithm>
+#include <arpa/inet.h>
+#include <array>
+#include <atomic>
+#include <charconv>
+#include <cstring>
+#include <memory>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
+
+namespace akira::net {
+namespace {
+
+constexpr std::uint16_t dnsClassIn = 1;
+constexpr std::uint16_t dnsTypeAaaa = 28;
+constexpr std::size_t dnsHeaderSize = 12;
+
+std::string_view trimmed(std::string_view value)
+{
+    constexpr std::string_view whitespace = " \t\r\n";
+    const auto first = value.find_first_not_of(whitespace);
+    if (first == std::string_view::npos)
+        return {};
+    const auto last = value.find_last_not_of(whitespace);
+    return value.substr(first, last - first + 1);
+}
+
+std::uint16_t readU16(std::span<const std::uint8_t> data, std::size_t offset)
+{
+    return static_cast<std::uint16_t>(
+        (static_cast<std::uint16_t>(data[offset]) << 8) | data[offset + 1]);
+}
+
+void appendU16(std::vector<std::uint8_t>& data, std::uint16_t value)
+{
+    data.push_back(static_cast<std::uint8_t>(value >> 8));
+    data.push_back(static_cast<std::uint8_t>(value & 0xff));
+}
+
+// Return the first byte after a DNS name. Compression pointers are followed to
+// validate their targets, but the returned offset always stays in the original
+// name's enclosing record.
+std::optional<std::size_t> skipDnsName(std::span<const std::uint8_t> data, std::size_t offset)
+{
+    std::size_t cursor = offset;
+    std::optional<std::size_t> encodedEnd;
+    unsigned int jumps = 0;
+
+    while (true)
+    {
+        if (cursor >= data.size())
+            return std::nullopt;
+        const auto length = data[cursor];
+        if ((length & 0xc0) == 0xc0)
+        {
+            if (cursor + 1 >= data.size() || ++jumps > 128)
+                return std::nullopt;
+            const auto pointer = static_cast<std::size_t>(
+                ((length & 0x3f) << 8) | data[cursor + 1]);
+            if (pointer >= data.size())
+                return std::nullopt;
+            if (!encodedEnd)
+                encodedEnd = cursor + 2;
+            cursor = pointer;
+            continue;
+        }
+        if ((length & 0xc0) != 0)
+            return std::nullopt;
+
+        ++cursor;
+        if (length == 0)
+            return encodedEnd.value_or(cursor);
+        if (length > 63 || cursor + length > data.size())
+            return std::nullopt;
+        cursor += length;
+    }
+}
+
+std::optional<std::uint16_t> parsePort(std::string_view value)
+{
+    unsigned int port = 0;
+    const auto [end, error] = std::from_chars(value.data(), value.data() + value.size(), port);
+    if (value.empty() || error != std::errc{} || end != value.data() + value.size() || port == 0 || port > 65535)
+        return std::nullopt;
+    return static_cast<std::uint16_t>(port);
+}
+
+std::optional<WireGuardEndpoint> decodeIp4p(const in6_addr& address)
+{
+    // The fixed 2001::/80 prefix leaves 16 bits for the port and 32 for IPv4.
+    static constexpr std::array<unsigned char, 10> prefix{0x20, 0x01, 0, 0, 0, 0, 0, 0, 0, 0};
+    if (!std::equal(prefix.begin(), prefix.end(), address.s6_addr))
+        return std::nullopt;
+
+    const auto port = static_cast<std::uint16_t>(
+        (static_cast<std::uint16_t>(address.s6_addr[10]) << 8) | address.s6_addr[11]);
+    if (port == 0)
+        return std::nullopt;
+
+    char host[INET_ADDRSTRLEN] = {};
+    if (!inet_ntop(AF_INET, address.s6_addr + 12, host, sizeof(host)))
+        return std::nullopt;
+    return WireGuardEndpoint{host, port, true};
+}
+
+std::optional<WireGuardEndpoint> decodeIp4pAnswers(const std::vector<DnsAaaaAddress>& answers)
+{
+    for (const auto& answer : answers)
+    {
+        in6_addr address = {};
+        static_assert(sizeof(address.s6_addr) == sizeof(answer));
+        std::memcpy(address.s6_addr, answer.data(), sizeof(answer));
+        if (auto decoded = decodeIp4p(address))
+            return decoded;
+    }
+    return std::nullopt;
+}
+
+#ifndef __SWITCH__
+std::optional<WireGuardEndpoint> resolveIp4p(const std::string& hostname)
+{
+    addrinfo hints = {};
+    hints.ai_family = AF_INET6;
+    hints.ai_socktype = SOCK_DGRAM;
+    hints.ai_protocol = IPPROTO_UDP;
+
+    addrinfo* raw = nullptr;
+    if (getaddrinfo(hostname.c_str(), nullptr, &hints, &raw) != 0)
+        return std::nullopt;
+    const std::unique_ptr<addrinfo, decltype(&freeaddrinfo)> addresses(raw, &freeaddrinfo);
+
+    for (const addrinfo* entry = raw; entry; entry = entry->ai_next)
+    {
+        if (entry->ai_family != AF_INET6 || entry->ai_addrlen < sizeof(sockaddr_in6))
+            continue;
+        const auto* address = reinterpret_cast<const sockaddr_in6*>(entry->ai_addr);
+        if (auto decoded = decodeIp4p(address->sin6_addr))
+            return decoded;
+    }
+    return std::nullopt;
+}
+#else
+std::optional<std::vector<DnsAaaaAddress>> queryDnsServer(
+    const std::vector<std::uint8_t>& query, const in_addr& dnsServer, std::uint16_t queryId)
+{
+    const int fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (fd < 0)
+        return std::nullopt;
+
+    sockaddr_in address = {};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(53);
+    address.sin_addr = dnsServer;
+    timeval timeout = {};
+    timeout.tv_sec = 3;
+
+    bool ok = setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) == 0;
+    ok = ok && connect(fd, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) == 0;
+    ok = ok && send(fd, query.data(), query.size(), 0) == static_cast<ssize_t>(query.size());
+
+    std::array<std::uint8_t, 4096> buffer = {};
+    const auto received = ok ? recv(fd, buffer.data(), buffer.size(), 0) : -1;
+    close(fd);
+    if (received <= 0)
+        return std::nullopt;
+    return parseDnsAaaaResponse(
+        std::span<const std::uint8_t>(buffer.data(), static_cast<std::size_t>(received)), queryId);
+}
+
+std::optional<WireGuardEndpoint> resolveIp4p(const std::string& hostname)
+{
+    u32 currentAddress = 0;
+    u32 subnetMask = 0;
+    u32 gateway = 0;
+    u32 primaryDns = 0;
+    u32 secondaryDns = 0;
+    if (R_FAILED(nifmGetCurrentIpConfigInfo(
+            &currentAddress, &subnetMask, &gateway, &primaryDns, &secondaryDns)))
+        return std::nullopt;
+
+    static std::atomic<std::uint16_t> nextQueryId{0x4b1a};
+    const auto queryId = nextQueryId.fetch_add(0x9e37, std::memory_order_relaxed);
+    const auto query = buildDnsAaaaQuery(hostname, queryId);
+    if (!query)
+        return std::nullopt;
+
+    std::array<in_addr, 2> servers = {};
+    servers[0].s_addr = primaryDns;
+    servers[1].s_addr = secondaryDns;
+    for (const auto& server : servers)
+    {
+        if (server.s_addr == 0)
+            continue;
+        const auto answers = queryDnsServer(*query, server, queryId);
+        if (answers && !answers->empty())
+        {
+            if (auto decoded = decodeIp4pAnswers(*answers))
+                return decoded;
+        }
+    }
+    return std::nullopt;
+}
+#endif
+
+} // namespace
+
+std::optional<std::vector<std::uint8_t>> buildDnsAaaaQuery(std::string_view hostname, std::uint16_t queryId)
+{
+    auto name = trimmed(hostname);
+    if (name.size() > 1 && name.back() == '.')
+        name.remove_suffix(1);
+    if (name.empty() || name.size() > 253)
+        return std::nullopt;
+
+    std::vector<std::uint8_t> query(dnsHeaderSize, 0);
+    query[0] = static_cast<std::uint8_t>(queryId >> 8);
+    query[1] = static_cast<std::uint8_t>(queryId & 0xff);
+    query[2] = 0x01; // Recursion desired.
+    query[5] = 1;    // One question.
+
+    std::size_t labelStart = 0;
+    while (labelStart < name.size())
+    {
+        const auto dot = name.find('.', labelStart);
+        const auto labelEnd = dot == std::string_view::npos ? name.size() : dot;
+        const auto length = labelEnd - labelStart;
+        if (length == 0 || length > 63)
+            return std::nullopt;
+        for (std::size_t i = labelStart; i < labelEnd; ++i)
+        {
+            const auto c = static_cast<unsigned char>(name[i]);
+            if (c < 0x21 || c > 0x7e)
+                return std::nullopt;
+        }
+        query.push_back(static_cast<std::uint8_t>(length));
+        query.insert(query.end(), name.begin() + static_cast<std::ptrdiff_t>(labelStart),
+            name.begin() + static_cast<std::ptrdiff_t>(labelEnd));
+        labelStart = dot == std::string_view::npos ? name.size() : dot + 1;
+    }
+    query.push_back(0);
+    appendU16(query, dnsTypeAaaa);
+    appendU16(query, dnsClassIn);
+    return query;
+}
+
+std::optional<std::vector<DnsAaaaAddress>> parseDnsAaaaResponse(
+    std::span<const std::uint8_t> response, std::uint16_t queryId)
+{
+    if (response.size() < dnsHeaderSize || readU16(response, 0) != queryId)
+        return std::nullopt;
+    const auto flags = readU16(response, 2);
+    if ((flags & 0x8000) == 0 || (flags & 0x000f) != 0)
+        return std::nullopt;
+
+    const auto questions = readU16(response, 4);
+    const auto answers = readU16(response, 6);
+    std::size_t offset = dnsHeaderSize;
+    for (std::uint16_t i = 0; i < questions; ++i)
+    {
+        const auto end = skipDnsName(response, offset);
+        if (!end || *end + 4 > response.size())
+            return std::nullopt;
+        offset = *end + 4;
+    }
+
+    std::vector<DnsAaaaAddress> result;
+    for (std::uint16_t i = 0; i < answers; ++i)
+    {
+        const auto nameEnd = skipDnsName(response, offset);
+        if (!nameEnd || *nameEnd + 10 > response.size())
+            return std::nullopt;
+        const auto type = readU16(response, *nameEnd);
+        const auto recordClass = readU16(response, *nameEnd + 2);
+        const auto dataLength = readU16(response, *nameEnd + 8);
+        const auto dataOffset = *nameEnd + 10;
+        if (dataOffset + dataLength > response.size())
+            return std::nullopt;
+        if (type == dnsTypeAaaa && recordClass == dnsClassIn && dataLength == 16)
+        {
+            DnsAaaaAddress address = {};
+            std::copy_n(response.begin() + static_cast<std::ptrdiff_t>(dataOffset), 16, address.begin());
+            result.push_back(address);
+        }
+        offset = dataOffset + dataLength;
+    }
+    return result;
+}
+
+std::optional<WireGuardEndpoint> parseIp4pEndpoint(std::string_view value)
+{
+    std::string text(trimmed(value));
+    if (text.size() >= 2 && text.front() == '[' && text.back() == ']')
+        text = text.substr(1, text.size() - 2);
+
+    in6_addr address = {};
+    if (inet_pton(AF_INET6, text.c_str(), &address) != 1)
+        return std::nullopt;
+    return decodeIp4p(address);
+}
+
+std::optional<WireGuardEndpoint> parseWireGuardEndpoint(std::string_view value)
+{
+    const std::string_view endpoint = trimmed(value);
+    if (endpoint.empty())
+        return std::nullopt;
+
+    if (endpoint.front() == '[')
+    {
+        const auto close = endpoint.find(']');
+        if (close == std::string_view::npos || close == 1)
+            return std::nullopt;
+        const std::string host(endpoint.substr(1, close - 1));
+        const std::string_view suffix = trimmed(endpoint.substr(close + 1));
+        if (suffix.empty())
+        {
+            if (auto ip4p = parseIp4pEndpoint(host))
+                return ip4p;
+            return WireGuardEndpoint{host, 51820, false};
+        }
+        if (suffix.front() != ':')
+            return std::nullopt;
+        const auto port = parsePort(trimmed(suffix.substr(1)));
+        if (!port)
+            return std::nullopt;
+        return WireGuardEndpoint{host, *port, false};
+    }
+
+    if (auto ip4p = parseIp4pEndpoint(endpoint))
+        return ip4p;
+
+    const auto colons = static_cast<std::size_t>(std::count(endpoint.begin(), endpoint.end(), ':'));
+    if (colons > 1)
+        return std::nullopt; // Non-IP4P IPv6 literals must use [address]:port.
+    if (colons == 1)
+    {
+        const auto separator = endpoint.rfind(':');
+        const std::string host(endpoint.substr(0, separator));
+        const auto port = parsePort(trimmed(endpoint.substr(separator + 1)));
+        if (host.empty() || !port)
+            return std::nullopt;
+        return WireGuardEndpoint{host, *port, false};
+    }
+
+    const std::string host(endpoint);
+    if (auto ip4p = resolveIp4p(host))
+        return ip4p;
+    return WireGuardEndpoint{host, 51820, false};
+}
+
+} // namespace akira::net
