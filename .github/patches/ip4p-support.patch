new file mode 100644
index 0000000000000000000000000000000000000000..276ef5def096e9bd21fb61eae1b5c71c216d7e39
--- /dev/null
+++ b/tests/test_wireguard_endpoint.cpp
@@ -0,0 +1,133 @@
+#include "test_util.hpp"
+
+#include "core/net/wireguard_endpoint.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+using akira::net::buildDnsAaaaQuery;
+using akira::net::parseDnsAaaaResponse;
+using akira::net::parseIp4pEndpoint;
+using akira::net::parseWireGuardEndpoint;
+
+TEST(ip4p_decodes_natmap_example)
+{
+    const auto endpoint = parseIp4pEndpoint("2001::0355:0101:0101");
+    REQUIRE(endpoint.has_value());
+    CHECK_EQ(endpoint->host, std::string("1.1.1.1"));
+    CHECK_EQ(endpoint->port, std::uint16_t{853});
+    CHECK(endpoint->fromIp4p);
+}
+
+TEST(ip4p_accepts_bracketed_literal_and_maximum_values)
+{
+    const auto bracketed = parseWireGuardEndpoint("[2001::0355:0101:0101]");
+    REQUIRE(bracketed.has_value());
+    CHECK_EQ(bracketed->host, std::string("1.1.1.1"));
+    CHECK_EQ(bracketed->port, std::uint16_t{853});
+
+    const auto maximum = parseIp4pEndpoint("2001::ffff:ffff:ffff");
+    REQUIRE(maximum.has_value());
+    CHECK_EQ(maximum->host, std::string("255.255.255.255"));
+    CHECK_EQ(maximum->port, std::uint16_t{65535});
+}
+
+TEST(ip4p_rejects_invalid_prefix_port_and_text)
+{
+    CHECK(!parseIp4pEndpoint("2002::0355:0101:0101"));
+    CHECK(!parseIp4pEndpoint("2001:db8::1"));
+    CHECK(!parseIp4pEndpoint("2001::0000:0101:0101"));
+    CHECK(!parseIp4pEndpoint("not-an-ip4p-address"));
+    CHECK(!parseIp4pEndpoint(""));
+}
+
+TEST(wireguard_regular_endpoints_are_unchanged)
+{
+    const auto domain = parseWireGuardEndpoint("vpn.example.com:51820");
+    REQUIRE(domain.has_value());
+    CHECK_EQ(domain->host, std::string("vpn.example.com"));
+    CHECK_EQ(domain->port, std::uint16_t{51820});
+    CHECK(!domain->fromIp4p);
+
+    const auto ipv4 = parseWireGuardEndpoint("192.0.2.10:1234");
+    REQUIRE(ipv4.has_value());
+    CHECK_EQ(ipv4->host, std::string("192.0.2.10"));
+    CHECK_EQ(ipv4->port, std::uint16_t{1234});
+
+    const auto ipv6 = parseWireGuardEndpoint("[2001:db8::1]:51820");
+    REQUIRE(ipv6.has_value());
+    CHECK_EQ(ipv6->host, std::string("2001:db8::1"));
+    CHECK_EQ(ipv6->port, std::uint16_t{51820});
+}
+
+TEST(wireguard_rejects_invalid_ports_and_unbracketed_ipv6)
+{
+    CHECK(!parseWireGuardEndpoint("vpn.example.com:0"));
+    CHECK(!parseWireGuardEndpoint("vpn.example.com:65536"));
+    CHECK(!parseWireGuardEndpoint("vpn.example.com:http"));
+    CHECK(!parseWireGuardEndpoint(":51820"));
+    CHECK(!parseWireGuardEndpoint("2001:db8::1"));
+    CHECK(!parseWireGuardEndpoint(""));
+}
+
+TEST(dns_aaaa_query_uses_standard_wire_format)
+{
+    const auto query = buildDnsAaaaQuery("ip4p.example.com", 0x1234);
+    REQUIRE(query.has_value());
+    REQUIRE(query->size() == 34);
+    CHECK_EQ((*query)[0], std::uint8_t{0x12});
+    CHECK_EQ((*query)[1], std::uint8_t{0x34});
+    CHECK_EQ((*query)[2], std::uint8_t{0x01});
+    CHECK_EQ((*query)[5], std::uint8_t{0x01});
+    CHECK_EQ((*query)[query->size() - 4], std::uint8_t{0x00});
+    CHECK_EQ((*query)[query->size() - 3], std::uint8_t{0x1c});
+    CHECK_EQ((*query)[query->size() - 2], std::uint8_t{0x00});
+    CHECK_EQ((*query)[query->size() - 1], std::uint8_t{0x01});
+
+    CHECK(!buildDnsAaaaQuery("bad..example.com", 1));
+    CHECK(!buildDnsAaaaQuery("bad example.com", 1));
+    CHECK(!buildDnsAaaaQuery(std::string(64, 'a') + ".example.com", 1));
+}
+
+TEST(dns_aaaa_response_extracts_compressed_ip4p_answer)
+{
+    auto response = buildDnsAaaaQuery("ip4p.example.com", 0x1234).value();
+    response[2] = 0x81;
+    response[3] = 0x80;
+    response[7] = 1;
+    const std::vector<std::uint8_t> answer{
+        0xc0, 0x0c,                         // Compressed owner name.
+        0x00, 0x1c, 0x00, 0x01,             // AAAA, IN.
+        0x00, 0x00, 0x00, 0x3c,             // TTL.
+        0x00, 0x10,                         // 16-byte RDATA.
+        0x20, 0x01, 0, 0, 0, 0, 0, 0, 0, 0,
+        0x03, 0x55, 0x01, 0x01, 0x01, 0x01, // 1.1.1.1:853.
+    };
+    response.insert(response.end(), answer.begin(), answer.end());
+
+    const auto addresses = parseDnsAaaaResponse(response, 0x1234);
+    REQUIRE(addresses.has_value());
+    REQUIRE(addresses->size() == 1);
+    CHECK_EQ((*addresses)[0][10], std::uint8_t{0x03});
+    CHECK_EQ((*addresses)[0][11], std::uint8_t{0x55});
+    CHECK_EQ((*addresses)[0][15], std::uint8_t{0x01});
+}
+
+TEST(dns_aaaa_response_rejects_invalid_messages)
+{
+    auto response = buildDnsAaaaQuery("ip4p.example.com", 0x1234).value();
+    response[2] = 0x81;
+    response[3] = 0x80;
+    CHECK(parseDnsAaaaResponse(response, 0x1234).has_value());
+    CHECK(!parseDnsAaaaResponse(response, 0x1235));
+    response[3] = 0x83; // NXDOMAIN.
+    CHECK(!parseDnsAaaaResponse(response, 0x1234));
+
+    const std::vector<std::uint8_t> truncated(12, 0);
+    CHECK(!parseDnsAaaaResponse(truncated, 0));
+
+    // A question name pointing to itself must not loop forever.
+    std::vector<std::uint8_t> loop{0x12, 0x34, 0x81, 0x80, 0, 1, 0, 0, 0, 0, 0, 0, 0xc0, 0x0c, 0, 0x1c, 0, 1};
+    CHECK(!parseDnsAaaaResponse(loop, 0x1234));
+}
