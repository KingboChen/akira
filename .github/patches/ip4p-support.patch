@@ -0,0 +1,38 @@
+#ifndef AKIRA_WIREGUARD_ENDPOINT_HPP
+#define AKIRA_WIREGUARD_ENDPOINT_HPP
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace akira::net {
+
+struct WireGuardEndpoint {
+    std::string host;
+    std::uint16_t port = 51820;
+    bool fromIp4p = false;
+};
+
+using DnsAaaaAddress = std::array<std::uint8_t, 16>;
+
+// Build and parse DNS AAAA messages. The transport uses IPv4 UDP, so these
+// queries also work on networks where the client has no IPv6 address.
+std::optional<std::vector<std::uint8_t>> buildDnsAaaaQuery(std::string_view hostname, std::uint16_t queryId);
+std::optional<std::vector<DnsAaaaAddress>> parseDnsAaaaResponse(
+    std::span<const std::uint8_t> response, std::uint16_t queryId);
+
+// Decode the NATMap IP4P form: 2001::{port}:{ipv4-hi16}:{ipv4-lo16}.
+std::optional<WireGuardEndpoint> parseIp4pEndpoint(std::string_view value);
+
+// Parse a regular WireGuard endpoint or resolve an IP4P AAAA record when no
+// explicit port is present. Regular endpoints retain the historical default
+// port of 51820.
+std::optional<WireGuardEndpoint> parseWireGuardEndpoint(std::string_view value);
+
+} // namespace akira::net
+
+#endif // AKIRA_WIREGUARD_ENDPOINT_HPP
